<%- include('partials/header', { title: `${campaign.name} · PhishGuard`, error: null }) %><div class="page-heading"><div><p class="eyebrow">Campaign detail</p><h1><%= campaign.name %></h1><p class="muted"><%= campaign.audience_label %> · created <%= campaign.created_at %></p></div><div class="button-row"><a class="button secondary" href="/campaigns/<%= campaign.id %>/report">Print report</a><a class="button primary" href="/campaigns/<%= campaign.id %>/report.csv">Download CSV</a></div></div><div class="notice info"><strong>Simulation link:</strong> <a href="/simulate/<%= campaign.public_token %>?participant_code=student-01">/simulate/<%= campaign.public_token %></a><br><small>Share only with participants who have authorized this exercise.</small></div><div class="metric-grid"><div class="metric-card"><span>Unique clicks</span><strong><%= metrics.clicks %></strong><small>opened the training page</small></div><div class="metric-card"><span>Dummy submissions</span><strong><%= metrics.submissions %></strong><small>raw values discarded</small></div><div class="metric-card"><span>Participants</span><strong><%= metrics.participants %></strong><small>using a training code</small></div><div class="metric-card accent"><span>Awareness rate</span><strong><%= metrics.awareness %>%</strong><small>clicked without submitting</small></div></div><section class="panel"><div class="panel-heading"><div><p class="eyebrow">Risk review</p><h2>Participant outcomes</h2></div></div><% if (participants.length) { %><div class="table-wrap"><table><thead><tr><th>Participant code</th><th>Clicks</th><th>Dummy submissions</th><th>Risk</th><th>Last seen</th></tr></thead><tbody><% participants.forEach((p) => { %><tr><td><strong><%= p.participant_code %></strong></td><td><%= p.clicks %></td><td><%= p.submissions %></td><td><span class="risk <%= p.risk_label.toLowerCase() %>"><%= p.risk_label %> · <%= p.risk_score %>/100</span></td><td><%= p.last_seen %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><h3>Waiting for a test participant</h3><p>Open the simulation link in a separate window and use a dummy participant code.</p></div><% } %></section><%- include('partials/footer') %>
