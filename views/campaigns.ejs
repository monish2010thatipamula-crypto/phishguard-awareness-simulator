<%- include('partials/header', { title: 'Campaigns · PhishGuard', error: null }) %><div class="page-heading"><div><p class="eyebrow">Training programs</p><h1>Campaigns</h1><p class="muted">Create and review authorized simulations.</p></div><a class="button primary" href="/campaigns/new">+ New simulation</a></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>Campaign</th><th>Audience</th><th>Status</th><th>Created</th><th></th></tr></thead><tbody><% campaigns.forEach((c) => { %><tr><td><strong><%= c.name %></strong><br><span class="muted"><%= c.sender_label %></span></td><td><%= c.audience_label %></td><td><span class="status <%= c.status %>"><%= c.status %></span></td><td><%= c.created_at %></td><td><a class="text-link" href="/campaigns/<%= c.id %>">View report →</a></td></tr><% }) %></tbody></table></div></section><%- include('partials/footer') %>
