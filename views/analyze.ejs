<%- include('partials/header', { title: 'Link analyzer · PhishGuard', error: null }) %>
<div class="page-heading"><div><p class="eyebrow">Offline inspection</p><h1>Phishing link analyzer</h1><p class="muted">Separate likely suspicious links from ordinary-looking links using explainable URL signals.</p></div></div>
<div class="notice info"><strong>Privacy by design:</strong> the URL is never opened. DNS lookup only resolves the destination domain to infrastructure IP addresses; it does not identify the sender or link creator.</div>
<form method="post" class="panel"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><label>Paste a link<input name="url" placeholder="https://example.test/training" required></label><div class="form-actions"><button class="button primary" type="submit">Analyze offline</button></div></form>
<% if (result) { %>
<section class="panel"><div class="panel-heading"><div><p class="eyebrow">Heuristic result</p><h2><%= result.classification %></h2></div><span class="risk <%= result.severity === 'high' || result.severity === 'warning' ? 'high' : result.severity === 'success' ? 'low' : 'medium' %>"><%= result.severity %></span></div>
<p class="muted"><code><%= result.url %></code></p>
<% if (result.simulation) { %><h3>Protected redirect simulation</h3><p class="muted">Response headers only. The simulator did not read page content, submit forms, use credentials or cookies, or collect customer data.</p><% if (result.simulation.chain.length) { %><p><strong>Observed hosts:</strong> <code><%= result.simulation.chain.map((hop) => hop.hostname).join(' → ') %></code></p><% } %><% if (result.simulation.domainChanged) { %><div class="notice warning"><strong>Domain changed:</strong> the redirect crossed registrable domains. Verify the final destination through a trusted channel.</div><% } %><% } %>
<% if (result.browserSimulation) { %><h3>Isolated browser simulation</h3><p class="muted"><%= result.browserSimulation.privacy %></p><% if (!result.browserSimulation.available) { %><div class="notice info"><%= result.browserSimulation.warnings.join(' ') %></div><% } else if (result.browserSimulation.checked) { %><p><strong>Final observed URL:</strong> <code><%= result.browserSimulation.finalUrl %></code></p><p><strong>Protected findings:</strong> <%= result.browserSimulation.sensitiveFormCount || 0 %> sensitive form(s), <%= result.browserSimulation.blockedRequestCount || 0 %> blocked request(s).</p><% } %><% if (result.browserSimulation.warnings.length) { %><ul><% result.browserSimulation.warnings.forEach((warning) => { %><li><%= warning %></li><% }) %></ul><% } %><% } %>
<% if (result.destination) { %><h3>Destination IP finder</h3><p><strong>Domain:</strong> <code><%= result.domain %></code></p><p><strong>Resolved destination IP<%= result.destination.addresses.length === 1 ? '' : 's' %>:</strong> <code><%= result.destination.addresses.length ? result.destination.addresses.join(', ') : 'Unavailable' %></code></p><p class="muted"><%= result.destination.note %></p><% } %>
<h3>Signals found</h3><ul><% result.reasons.forEach((reason) => { %><li><%= reason %></li><% }) %></ul>
<h3>Underlying link check</h3><p><%= result.resolutionNote %></p><% if ((result.embeddedLinks || []).length) { %><ul><% (result.embeddedLinks || []).forEach((link) => { %><li><code><%= link.url || link %></code></li><% }) %></ul><% } %>
</section><% } %><%- include('partials/footer') %>
