<%- include('partials/header', { title: 'New simulation · PhishGuard', error }) %><div class="page-heading"><div><p class="eyebrow">Campaign builder</p><h1>New awareness simulation</h1><p class="muted">Design a fictional scenario for an authorized classroom or lab group.</p></div></div><div class="notice warning"><strong>Safety boundary:</strong> use fictional content only. This tool does not send emails, integrate with third-party services, or store passwords.</div><form method="post" class="panel form-panel"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><div class="form-grid"><% [['name','Campaign name','Quarterly security awareness'],['audience_label','Audience label','College Lab A'],['subject','Email subject (fictional)','Review your training notice'],['sender_label','Sender label (fictional)','Campus IT Training']].forEach(([name,label,placeholder]) => { %><label><%= label %><input name="<%= name %>" value="<%= form[name] || '' %>" placeholder="<%= placeholder %>" required></label><% }) %><label class="full">Scenario copy<textarea name="lure_text" rows="4" required><%= form.lure_text || '' %></textarea><small>Do not use real brands, real login links, or requests for sensitive data.</small></label><label class="full">Landing-page learning message<textarea name="landing_message" rows="3" required><%= form.landing_message || '' %></textarea></label></div><div class="form-actions"><a class="button secondary" href="/dashboard">Cancel</a><button class="button primary" type="submit">Create simulation</button></div></form><%- include('partials/footer') %>
