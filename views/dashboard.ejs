<%- include('partials/header', { title: 'Dashboard · PhishGuard', error: null }) %><div class="page-heading"><div><p class="eyebrow">Overview</p><h1>Awareness dashboard</h1><p class="muted">A privacy-preserving view of your classroom simulations.</p></div><a class="button primary" href="/campaigns/new">+ New simulation</a></div><div class="metric-grid"><div class="metric-card"><span>All campaigns</span><strong><%= totals.campaigns || 0 %></strong><small>created in this lab</small></div><div class="metric-card"><span>Active campaigns</span><strong><%= totals.active_campaigns || 0 %></strong><small>available for testing</small></div><div class="metric-card"><span>Training clicks</span><strong><%= totals.clicks || 0 %></strong><small>anonymized events</small></div><div class="metric-card accent"><span>Awareness rate</span><strong><%= totals.awareness %>%</strong><small>clicked without submitting</small></div></div><section class="panel"><div class="panel-heading"><div><p class="eyebrow">Recent work</p><h2>Campaigns</h2></div><a class="text-link" href="/campaigns">View all →</a></div><% if (campaigns.length) { %><div class="table-wrap"><table><thead><tr><th>Campaign</th><th>Audience</th><th>Status</th><th>Created</th><th></th></tr></thead><tbody><% campaigns.forEach((c) => { %><tr><td><strong><%= c.name %></strong><br><span class="muted"><%= c.subject %></span></td><td><%= c.audience_label %></td><td><span class="status <%= c.status %>"><%= c.status %></span></td><td><%= c.created_at %></td><td><a class="text-link" href="/campaigns/<%= c.id %>">Open</a></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><h3>No simulations yet</h3><p>Create a campaign to generate a safe, shareable training page.</p><a class="button secondary" href="/campaigns/new">Create first simulation</a></div><% } %></section><%- include('partials/footer') %>
